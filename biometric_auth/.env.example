# Copy to .env and fill in. Never commit .env.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite (default) or PostgreSQL, e.g.
# DATABASE_URL=postgresql+asyncpg://biosentinel:biosentinel@localhost:5432/biosentinel
DATABASE_URL=sqlite+aiosqlite:///./biometric_auth.db

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Timed lockout: failures before a lock, and lock length in minutes for the
# 1st, 2nd, 3rd+ lock in a row.
MAX_FAILED_LOGIN_ATTEMPTS=3
LOCKOUT_BACKOFF_MINUTES=1,5,15

LOGIN_RATE_LIMIT_PER_MINUTE=10
ENROLL_RATE_LIMIT_PER_MINUTE=5
REFRESH_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=4194304

# Only set when running behind a reverse proxy you control (its IP).
TRUSTED_PROXIES=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MATCH_THRESHOLD=0.6
FACE_CONFIDENCE_THRESHOLD=0.75
# Off: rejected genuine users too often on a normal webcam.
DEEPFACE_ANTI_SPOOFING=false

LM_STUDIO_URL=http://localhost:1234/v1

# Dev only.
DEMO_MODE=false
AUTO_CREATE_TABLES=false
